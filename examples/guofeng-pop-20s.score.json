{
  "title": "国风流行向 20s（流行和声 + 中国乐器）",
  "bpm": 100,
  "beats_per_bar": 4,
  "key": "A minor",
  "humanize_ms": 8,
  "design": {
    "mood": "国风、抒情中带点气势；不追求传统民乐，要的是流行歌曲里那种“中国乐器 + 流行和声”",
    "progression": "A 段小调 1-6-3-7（Am F C G），B 段王道 4-5-3（F G Em），END 回 Am",
    "motif": "E4:1 A4:.5 C5:.5 B4:2（二胡，1 小节）",
    "variations": ["同节奏换音(F、C 和弦上)", "换尾(G 小节停在 A4 悬着)", "B 段升高八度式抬升(C5 起，F5/G5 长音)", "END 回到主音 A"],
    "structure": "A 4 + B 3 + END 1；二胡主旋律，竹笛 B 段加入作高八度对位",
    "melody": ["erhu", "dizi"],
    "chords": {"A": ["Am", "F", "C", "G"], "B": ["F", "G", "Em"], "END": ["Am"]},
    "timbre_reason": {
      "erhu": "主旋律。弓弦的长音和滑入带来“中国味”和叙事感，承担歌声的角色；中音区，不抢钢琴类乐器，避免高音区的尖亮。",
      "guzheng": "8 分音符琶音铺底（A 段轻、B 段 16 分），承担节奏与和声填充；这是国风流行里最标志性的质感，但和弦本身是普通流行和弦。",
      "pipa": "A 段只在后半偶尔点缀，B 段用整小节同音轮指推高潮；颗粒感强，和古筝的绵长形成对比。",
      "dizi": "B 段才进，高八度对位，增加亮度与空间；A 段不出现，保留惊喜。",
      "pad": "弦乐垫提供流行歌曲式的和声厚度，音量压低，不抢主旋律。",
      "bass": "手指贝斯走根音+五度，给流行律动一个稳的底；不用古风长持续低音，因为这里和声是流行向。",
      "perc": "标准鼓组的底鼓、边击、沙锤保持流行律动；B 段加大鼓，结尾用大鼓+锣一击收住，不撤声部。"
    }
  },
